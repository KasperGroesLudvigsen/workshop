<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Summer House Screener</title>
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<link rel="stylesheet" href="https://unpkg.com/leaflet.markercluster@1.5.3/dist/MarkerCluster.css" />
<link rel="stylesheet" href="https://unpkg.com/leaflet.markercluster@1.5.3/dist/MarkerCluster.Default.css" />
<script src="https://unpkg.com/leaflet.markercluster@1.5.3/dist/leaflet.markercluster.js"></script>
<style>
  :root { color-scheme: light; }
  * { box-sizing: border-box; }
  body { margin: 0; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; background: #f7f7f5; color: #1c1c1c; }
  header { padding: 12px 16px; background: #14343b; color: #fff; display: flex; align-items: center; gap: 16px; flex-wrap: wrap; }
  header h1 { font-size: 16px; margin: 0; font-weight: 600; }
  header .count { font-size: 13px; opacity: 0.85; }
  #filters { display: flex; gap: 10px; flex-wrap: wrap; padding: 10px 16px; background: #fff; border-bottom: 1px solid #ddd; align-items: end; }
  #filters label { display: flex; flex-direction: column; font-size: 11px; color: #555; gap: 2px; }
  #filters input[type="number"] { width: 90px; padding: 4px 6px; font-size: 13px; border: 1px solid #ccc; border-radius: 4px; }
  #filters label.checkbox { flex-direction: row; align-items: center; gap: 6px; font-size: 12px; }
  #layout { display: flex; height: calc(100vh - 116px); }
  #map { flex: 0 0 auto; min-width: 200px; }
  #resizer { flex: 0 0 6px; cursor: col-resize; background: #e2e0d8; touch-action: none; }
  #resizer:hover, #resizer.dragging { background: #cfcbbd; }
  #table-wrap { flex: 1 1 auto; overflow: auto; background: #fff; min-width: 200px; }
  table { border-collapse: collapse; width: 100%; font-size: 12px; table-layout: fixed; min-width: 1400px; }
  th, td { padding: 6px 8px; border-bottom: 1px solid #eee; white-space: nowrap; text-align: left; overflow: hidden; text-overflow: ellipsis; }
  tr { height: 28px; }
  th { position: sticky; top: 0; background: #f0efe9; cursor: pointer; user-select: none; z-index: 1; white-space: normal; }
  th.sorted::after { content: " \25BE"; }
  tbody tr:not(.spacer):hover { background: #fbf8ee; cursor: pointer; }
  tr.spacer td { padding: 0; border: none; }
  a.ext-link { margin-right: 6px; font-size: 11px; }
  .reason-none { color: #a33; }
  .reason-ok { color: #2a7a3b; }
  button.action-btn { border: 1px solid #ccc; background: #fff; border-radius: 4px; padding: 2px 5px; font-size: 12px; cursor: pointer; margin-right: 4px; }
  button.action-btn:hover { background: #f0efe9; }
  button.action-btn.active { background: #fff2c2; border-color: #e0b400; }
  tr.row-liked { background: #fffbea; }
  tr.row-hidden { opacity: 0.5; }
  /* Fixed (not max-) height: reserves the box before the image has loaded,
     so Leaflet's popup auto-pan -- computed once, at open time -- doesn't
     under-measure the popup and leave part of it above the map. */
  .popup-photo { width: 100%; height: 140px; object-fit: cover; border-radius: 4px; display: block; margin-bottom: 6px; }
  .popup-title { font-size: 14px; font-weight: 700; }
  .popup-price { font-size: 14px; font-weight: 700; color: #14343b; margin-top: 2px; }
  .popup-meta { color: #666; font-size: 11px; margin-top: 2px; }
  .popup-section { margin-top: 5px; }
  .popup-label { font-weight: 600; color: #333; }
  .popup-links { margin-top: 6px; padding-top: 6px; border-top: 1px solid #eee; }
</style>
</head>
<body>
<header>
  <h1>Summer House Screener</h1>
  <span class="count"><span id="visible-count">0</span> of {{ listings|length }} listings passing current filters</span>
</header>
<div id="filters">
  <label>Water (km) <input type="number" id="f-water" step="0.5" value="{{ config.water_km }}"></label>
  <label>Hangout (km) <input type="number" id="f-hangout" step="0.5" value="{{ config.hangout_km }}"></label>
  <label>Grocery (km) <input type="number" id="f-grocery" step="0.5" value="{{ config.grocery_km }}"></label>
  <label class="checkbox"><input type="checkbox" id="f-lake-strict" {% if config.lake_strict %}checked{% endif %}> Strict lake eligibility</label>
  <label class="checkbox"><input type="checkbox" id="f-liked-only"> Show only liked</label>
  <label class="checkbox"><input type="checkbox" id="f-show-hidden"> Show hidden</label>
  <label>Min price <input type="number" id="f-price-min"></label>
  <label>Max price <input type="number" id="f-price-max"></label>
  <label>Min rooms <input type="number" id="f-rooms-min"></label>
  <label>Min m² <input type="number" id="f-size-min"></label>
  <label>Min lot m² <input type="number" id="f-lot-min"></label>
  <label>Min build year <input type="number" id="f-year-min"></label>
</div>
<div id="layout">
  <div id="map"></div>
  <div id="resizer" title="Drag to resize map/table"></div>
  <div id="table-wrap">
    <table id="table">
      <colgroup>
        <col style="width:145px">
        <col style="width:100px">
        <col style="width:70px">
        <col style="width:60px">
        <col style="width:60px">
        <col style="width:90px">
        <col style="width:70px">
        <col style="width:60px">
        <col style="width:65px">
        <col style="width:65px">
        <col style="width:75px">
        <col style="width:55px">
        <col style="width:60px">
        <col style="width:45px">
        <col style="width:60px">
        <col style="width:55px">
        <col style="width:50px">
        <col style="width:110px">
        <col style="width:190px">
      </colgroup>
      <thead>
        <tr>
          <th>★</th>
          <th data-key="price">Price</th>
          <th data-key="water_open_loose">Open water (km)</th>
          <th data-key="water_sea">Sea (km)</th>
          <th data-key="water_lake">Lake (km)</th>
          <th data-key="lake_reason">Lake signal</th>
          <th data-key="hangout_km">Hangout (km)</th>
          <th data-key="hangout_count">Hangouts within</th>
          <th data-key="grocery_km">Grocery (km)</th>
          <th data-key="marina_km">Marina (km)</th>
          <th data-key="playground_km">Playground (km)</th>
          <th data-key="pool_km">Pool (km)</th>
          <th data-key="beach_km">Beach (km)</th>
          <th data-key="size_m2">m²</th>
          <th data-key="lot_size_m2">Lot m²</th>
          <th data-key="rooms">Rooms</th>
          <th data-key="build_year">Year</th>
          <th data-key="flood_risk">Flood risk</th>
          <th>Links</th>
        </tr>
      </thead>
      <tbody id="table-body"></tbody>
    </table>
  </div>
</div>
<script>
const LISTINGS = {{ listings_json|safe }};
const DEFAULT_CONFIG = {{ config_json|safe }};

const STORAGE_KEY_LIKED = 'summer-house-screener:liked';
const STORAGE_KEY_HIDDEN = 'summer-house-screener:hidden';
const STORAGE_KEY_SPLIT = 'summer-house-screener:split';

function loadIdSet(key) {
  try {
    const raw = localStorage.getItem(key);
    return raw ? new Set(JSON.parse(raw)) : new Set();
  } catch (e) {
    return new Set(); // private browsing / storage disabled -- degrade to "nothing persists"
  }
}
function saveIdSet(key, set) {
  try {
    localStorage.setItem(key, JSON.stringify([...set]));
  } catch (e) { /* ignore -- same degrade-gracefully reasoning as loadIdSet */ }
}

let likedIds = loadIdSet(STORAGE_KEY_LIKED);
let hiddenIds = loadIdSet(STORAGE_KEY_HIDDEN);

function toggleLiked(id) {
  if (likedIds.has(id)) likedIds.delete(id); else likedIds.add(id);
  saveIdSet(STORAGE_KEY_LIKED, likedIds);
  computeAndRender();
}
function toggleHidden(id) {
  if (hiddenIds.has(id)) hiddenIds.delete(id); else hiddenIds.add(id);
  saveIdSet(STORAGE_KEY_HIDDEN, hiddenIds);
  computeAndRender();
}

// -- Map + marker clustering ------------------------------------------------
// A plain L.marker per listing (the old approach) froze the tab for 60+
// seconds at full-region scale (~1,300 markers created synchronously). A
// cluster group batches marker insertion across animation frames
// (chunkedLoading) instead of blocking the main thread in one go, and only
// paints individual pins once you're zoomed in enough to see them apart.
let map = null;
let clusterGroup = null;
const markersById = new Map();

if (typeof L !== 'undefined') {
  map = L.map('map').setView([55.5, 11.6], 9);
  L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
    maxZoom: 19,
    attribution: '&copy; OpenStreetMap contributors'
  }).addTo(map);
  if (typeof L.markerClusterGroup === 'function') {
    clusterGroup = L.markerClusterGroup({ chunkedLoading: true, spiderfyOnMaxZoom: true });
    map.addLayer(clusterGroup);
  }
} else {
  document.getElementById('map').innerHTML =
    '<p style="padding:16px;color:#a33;">Leaflet failed to load from the CDN (offline?) — table still works below.</p>';
}

function addMarker(marker) {
  if (clusterGroup) clusterGroup.addLayer(marker); else marker.addTo(map);
}
function clearMarkers() {
  if (clusterGroup) { clusterGroup.clearLayers(); }
  else { markersById.forEach(m => map.removeLayer(m)); }
}

// Reveal a (possibly clustered) marker and open its popup -- used when a
// table row is clicked.
function selectListing(id) {
  const marker = markersById.get(id);
  if (!marker || !map) return;
  const openAndPan = () => { map.panTo(marker.getLatLng()); marker.openPopup(); };
  if (clusterGroup && typeof clusterGroup.zoomToShowLayer === 'function') {
    clusterGroup.zoomToShowLayer(marker, openAndPan);
  } else {
    openAndPan();
  }
}

let sortState = { key: 'hangout_km', dir: 1 };

function fmt(n, digits) {
  if (n === null || n === undefined || Number.isNaN(n)) return '—';
  return Number(n).toFixed(digits === undefined ? 2 : digits);
}
function fmtPrice(price) {
  if (price === null || price === undefined) return '—';
  return Number(price).toLocaleString('da-DK') + ' kr';
}
// Distinguishes "category not resolved yet" from "resolved, nothing found
// within radius" -- both used to render as the same bare "—".
function fmtCategoryKm(cat, km) {
  if (!cat) return '<em>n/a</em>';
  if (km === null || km === undefined) return '<em>none</em>';
  return fmt(km);
}
// Kystdirektoratet only publishes hazard data within its own designated
// risk areas -- outside one, a listing isn't "safe", it's simply unassessed,
// so that's shown as its own state rather than folded into "no risk found".
function fmtFloodRisk(fr) {
  if (!fr || !fr.assessed) return '<em>not assessed</em>';
  if (fr.shortest_hazard_return_period_years == null) return 'no mapped risk';
  return `≤${fr.shortest_hazard_return_period_years}yr storm surge`;
}

function deriveRow(listing, cfg) {
  const water = listing.water;
  const openWater = cfg.lakeStrict ? water.open_water_km_strict : water.open_water_km_loose;
  const lakeCandidate = cfg.lakeStrict ? water.nearest_eligible_lake : water.nearest_lake_any;
  const hangout = listing.hangout;
  const grocery = listing.grocery;

  function categoryDistance(cat) {
    return cat ? cat.nearest_km : null;
  }
  function countWithin(cat, radiusKm) {
    if (!cat) return null;
    return cat.candidates.filter(c => c.distance_km <= radiusKm).length;
  }

  const passesWater = openWater !== null && openWater <= cfg.waterKm;
  const hangoutKm = categoryDistance(hangout);
  const groceryKm = categoryDistance(grocery);
  const passesHangout = hangoutKm === null ? true : hangoutKm <= cfg.hangoutKm; // null = not yet evaluated (pre-M5)
  const passesGrocery = groceryKm === null ? true : groceryKm <= cfg.groceryKm;

  return {
    listing,
    openWater,
    lakeCandidate,
    hangoutKm,
    hangoutCount: countWithin(hangout, cfg.hangoutKm),
    groceryKm,
    marinaKm: categoryDistance(listing.marina),
    playgroundKm: categoryDistance(listing.playground),
    poolKm: categoryDistance(listing.pool),
    beachKm: categoryDistance(listing.beach),
    passes: passesWater && passesHangout && passesGrocery,
    liked: likedIds.has(listing.listing_id),
    hidden: hiddenIds.has(listing.listing_id),
  };
}

function currentConfig() {
  return {
    waterKm: parseFloat(document.getElementById('f-water').value),
    hangoutKm: parseFloat(document.getElementById('f-hangout').value),
    groceryKm: parseFloat(document.getElementById('f-grocery').value),
    lakeStrict: document.getElementById('f-lake-strict').checked,
    likedOnly: document.getElementById('f-liked-only').checked,
    showHidden: document.getElementById('f-show-hidden').checked,
    priceMin: parseFloat(document.getElementById('f-price-min').value) || null,
    priceMax: parseFloat(document.getElementById('f-price-max').value) || null,
    roomsMin: parseFloat(document.getElementById('f-rooms-min').value) || null,
    sizeMin: parseFloat(document.getElementById('f-size-min').value) || null,
    lotMin: parseFloat(document.getElementById('f-lot-min').value) || null,
    yearMin: parseFloat(document.getElementById('f-year-min').value) || null,
  };
}

function applyExtraFilters(row, cfg) {
  const l = row.listing;
  if (cfg.priceMin !== null && (l.price === null || l.price < cfg.priceMin)) return false;
  if (cfg.priceMax !== null && (l.price === null || l.price > cfg.priceMax)) return false;
  if (cfg.roomsMin !== null && (l.rooms === null || l.rooms < cfg.roomsMin)) return false;
  if (cfg.sizeMin !== null && (l.size_m2 === null || l.size_m2 < cfg.sizeMin)) return false;
  if (cfg.lotMin !== null && (l.lot_size_m2 === null || l.lot_size_m2 < cfg.lotMin)) return false;
  if (cfg.yearMin !== null && (l.build_year === null || l.build_year < cfg.yearMin)) return false;
  return true;
}

function sortRows(rows) {
  const { key, dir } = sortState;
  const getters = {
    water_open_loose: r => r.openWater,
    water_sea: r => r.listing.water.sea_distance_km,
    water_lake: r => r.lakeCandidate ? r.lakeCandidate.distance_km : null,
    lake_reason: r => r.lakeCandidate ? r.lakeCandidate.eligibility_reason : '',
    hangout_km: r => r.hangoutKm,
    hangout_count: r => r.hangoutCount,
    grocery_km: r => r.groceryKm,
    marina_km: r => r.marinaKm,
    playground_km: r => r.playgroundKm,
    pool_km: r => r.poolKm,
    beach_km: r => r.beachKm,
    price: r => r.listing.price,
    size_m2: r => r.listing.size_m2,
    lot_size_m2: r => r.listing.lot_size_m2,
    rooms: r => r.listing.rooms,
    build_year: r => r.listing.build_year,
    flood_risk: r => r.listing.flood_risk.shortest_hazard_return_period_years,
  };
  const getter = getters[key] || getters.hangout_km;
  return rows.slice().sort((a, b) => {
    const av = getter(a), bv = getter(b);
    if (av === null || av === undefined) return 1;
    if (bv === null || bv === undefined) return -1;
    if (av < bv) return -1 * dir;
    if (av > bv) return 1 * dir;
    return 0;
  });
}

// -- Table virtualization ----------------------------------------------------
// The old code rendered every row's <tr> into the DOM at once -- ~1,300 rows
// (plus ~1,300 markers above) is what froze the tab. Only rows actually
// scrolled into view (plus a small buffer) are ever in the DOM; two spacer
// rows above/below make the scrollbar behave as if every row were present.
const ROW_HEIGHT = 28;
let currentRows = [];

function computeAndRender() {
  const cfg = currentConfig();
  let rows = LISTINGS.map(l => deriveRow(l, cfg)).filter(r => r.passes).filter(r => applyExtraFilters(r, cfg));
  rows = rows.filter(r => cfg.showHidden || !r.hidden);
  if (cfg.likedOnly) rows = rows.filter(r => r.liked);
  rows = sortRows(rows);
  currentRows = rows;

  document.getElementById('visible-count').textContent = rows.length;

  updateMarkers(rows);
  renderVisibleRows();
}

function updateMarkers(rows) {
  clearMarkers();
  markersById.clear();
  if (!map) return;
  for (const row of rows) {
    const l = row.listing;
    const marker = L.marker([l.lat, l.lon]);
    marker.bindPopup(() => popupHtml(row)); // built lazily, only if opened
    addMarker(marker);
    markersById.set(l.listing_id, marker);
  }
}

function rowHtml(row) {
  const l = row.listing;
  const cls = ['row-clickable'];
  if (row.liked) cls.push('row-liked');
  if (row.hidden) cls.push('row-hidden');
  return `
    <tr data-id="${l.listing_id}" class="${cls.join(' ')}">
      <td>${actionButtonsHtml(row)}</td>
      <td>${fmtPrice(l.price)}</td>
      <td>${fmt(row.openWater)}</td>
      <td>${fmt(l.water.sea_distance_km)}</td>
      <td>${row.lakeCandidate ? fmt(row.lakeCandidate.distance_km) : '—'}</td>
      <td class="${row.lakeCandidate && row.lakeCandidate.eligible ? 'reason-ok' : 'reason-none'}">${row.lakeCandidate ? row.lakeCandidate.eligibility_reason : '—'}</td>
      <td>${fmtCategoryKm(l.hangout, row.hangoutKm)}</td>
      <td>${row.hangoutCount === null ? '—' : row.hangoutCount}</td>
      <td>${fmtCategoryKm(l.grocery, row.groceryKm)}</td>
      <td>${fmtCategoryKm(l.marina, row.marinaKm)}</td>
      <td>${fmtCategoryKm(l.playground, row.playgroundKm)}</td>
      <td>${fmtCategoryKm(l.pool, row.poolKm)}</td>
      <td>${fmtCategoryKm(l.beach, row.beachKm)}</td>
      <td>${l.size_m2 ?? '—'}</td>
      <td>${l.lot_size_m2 ?? '—'}</td>
      <td>${l.rooms ?? '—'}</td>
      <td>${l.build_year ?? '—'}</td>
      <td>${fmtFloodRisk(l.flood_risk)}</td>
      <td>${linksHtml(l)}</td>
    </tr>
  `;
}

function renderVisibleRows() {
  const wrap = document.getElementById('table-wrap');
  const tbody = document.getElementById('table-body');
  const theadH = document.querySelector('#table thead').getBoundingClientRect().height;
  // scrollTop measures from the top of the scrollable content, which
  // includes the sticky thead's normal-flow space -- tbody row 0 starts
  // theadH px in, not at 0.
  const scrollTop = Math.max(0, wrap.scrollTop - theadH);
  const viewportH = wrap.clientHeight || 600;
  const buffer = 10;
  const startIdx = Math.max(0, Math.floor(scrollTop / ROW_HEIGHT) - buffer);
  const endIdx = Math.min(currentRows.length, Math.ceil((scrollTop + viewportH) / ROW_HEIGHT) + buffer);
  const topSpacerH = startIdx * ROW_HEIGHT;
  const bottomSpacerH = Math.max(0, currentRows.length - endIdx) * ROW_HEIGHT;
  const colCount = document.querySelectorAll('#table thead th').length;

  let html = '';
  if (topSpacerH > 0) html += `<tr class="spacer" style="height:${topSpacerH}px"><td colspan="${colCount}"></td></tr>`;
  for (let i = startIdx; i < endIdx; i++) html += rowHtml(currentRows[i]);
  if (bottomSpacerH > 0) html += `<tr class="spacer" style="height:${bottomSpacerH}px"><td colspan="${colCount}"></td></tr>`;
  tbody.innerHTML = html;
}

let scrollRAF = null;
document.getElementById('table-wrap').addEventListener('scroll', () => {
  if (scrollRAF) return;
  scrollRAF = requestAnimationFrame(() => { scrollRAF = null; renderVisibleRows(); });
});

// Clicking a row (but not a button/link inside it) shows the matching pin.
document.getElementById('table-body').addEventListener('click', (e) => {
  if (e.target.closest('button, a')) return;
  const tr = e.target.closest('tr[data-id]');
  if (tr) selectListing(tr.dataset.id);
});

// Only the top 3 nearest per category are listed in a popup -- the full
// candidate list can be long at low thresholds, and a popup isn't the place
// to read all of them.
function namesList(cat, radiusKm) {
  if (!cat) return '<em>not yet available</em>';
  const within = cat.candidates.filter(c => c.distance_km <= radiusKm); // already sorted by ascending distance
  if (within.length === 0) return '<em>none within radius</em>';
  const shown = within.slice(0, 3).map(c => `${c.name} (${fmt(c.distance_km)} km)`).join(', ');
  const more = within.length > 3 ? ` <em>+${within.length - 3} more</em>` : '';
  return shown + more;
}

// A Maps text search for the business's name, anchored by its resolved
// street+town when we have one (CVR/web-discovered businesses) or its
// coordinates otherwise (OSM POIs have no address, only lat/lon).
function mapsSearchUrl(name, street, town, lat, lon) {
  const query = (street && town) ? `${name}, ${street}, ${town}` :
                (lat != null && lon != null) ? `${name} @${lat},${lon}` : name;
  return `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(query)}`;
}

function hangoutLinksHtml(cat, radiusKm) {
  if (!cat) return '<em>not yet available</em>';
  const within = cat.candidates.filter(c => c.distance_km <= radiusKm);
  if (within.length === 0) return '<em>none within radius</em>';
  const shown = within.slice(0, 3)
    .map(c => `<a href="${mapsSearchUrl(c.name, c.street, c.town, c.lat, c.lon)}" target="_blank" rel="noopener">${c.name}</a> (${fmt(c.distance_km)} km)`)
    .join(', ');
  const more = within.length > 3 ? ` <em>+${within.length - 3} more</em>` : '';
  return shown + more;
}

function popupHtml(row) {
  const l = row.listing;
  const cfg = currentConfig();
  const cityLine = [l.zip_code, l.town].filter(Boolean).join(' ');
  const photo = l.photo_url
    ? `<a href="${l.listing_url ?? '#'}" target="_blank" rel="noopener"><img class="popup-photo" src="${l.photo_url}" loading="lazy"></a>`
    : '';
  return `
    <div style="font-size:12px; max-width: 260px;">
      ${photo}
      <div class="popup-title">${l.address ?? l.listing_id}${cityLine ? ', ' + cityLine : ''}</div>
      <div class="popup-price">${fmtPrice(l.price)}</div>
      <div class="popup-meta">${l.size_m2 ?? '—'} m² &middot; ${l.rooms ?? '—'} rooms${l.build_year ? ' &middot; built ' + l.build_year : ''}</div>
      <div class="popup-section"><span class="popup-label">Open water:</span> ${fmt(row.openWater)} km (sea ${fmt(l.water.sea_distance_km)} km,
        lake ${row.lakeCandidate ? fmt(row.lakeCandidate.distance_km) + ' km, ' + row.lakeCandidate.eligibility_reason : 'n/a'})</div>
      <div class="popup-section"><span class="popup-label">Flood risk (storm surge):</span> ${fmtFloodRisk(l.flood_risk)}</div>
      <div class="popup-section"><span class="popup-label">Hangouts (${cfg.hangoutKm} km):</span> ${hangoutLinksHtml(l.hangout, cfg.hangoutKm)}</div>
      <div class="popup-section"><span class="popup-label">Grocery (${cfg.groceryKm} km):</span> ${namesList(l.grocery, cfg.groceryKm)}</div>
      <div class="popup-section"><span class="popup-label">Marina:</span> ${namesList(l.marina, 15)}</div>
      <div class="popup-section"><span class="popup-label">Playground:</span> ${namesList(l.playground, 15)}</div>
      <div class="popup-section"><span class="popup-label">Pool:</span> ${namesList(l.pool, 15)}</div>
      <div class="popup-section"><span class="popup-label">Beach:</span> ${namesList(l.beach, 15)}</div>
      <div class="popup-section">${actionButtonsHtml(row)}</div>
      <div class="popup-links">${linksHtml(l)}</div>
    </div>
  `;
}

function actionButtonsHtml(row) {
  const id = row.listing.listing_id;
  const likeLabel = row.liked ? '★ Liked' : '☆ Like';
  const hideLabel = row.hidden ? '🔁 Unhide' : '🙈 Hide';
  return `
    <button type="button" class="action-btn${row.liked ? ' active' : ''}" onclick="toggleLiked('${id}')">${likeLabel}</button>
    <button type="button" class="action-btn${row.hidden ? ' active' : ''}" onclick="toggleHidden('${id}')">${hideLabel}</button>
  `;
}

function linksHtml(l) {
  return `
    <a class="ext-link" href="${l.listing_url ?? '#'}" target="_blank" rel="noopener">Listing</a>
    <a class="ext-link" href="${l.map_links.google_pin}" target="_blank" rel="noopener">Pin</a>
    <a class="ext-link" href="${l.map_links.google_aerial}" target="_blank" rel="noopener">Aerial</a>
    <a class="ext-link" href="${l.map_links.google_street}" target="_blank" rel="noopener">Street</a>
    ${l.map_links.boligsiden_address ? `<a class="ext-link" href="${l.map_links.boligsiden_address}" target="_blank" rel="noopener">Boligsiden</a>` : ''}
  `;
}

document.querySelectorAll('#filters input').forEach(el => el.addEventListener('input', computeAndRender));
document.querySelectorAll('th[data-key]').forEach(th => {
  th.addEventListener('click', () => {
    const key = th.dataset.key;
    if (sortState.key === key) { sortState.dir *= -1; } else { sortState = { key, dir: 1 }; }
    document.querySelectorAll('th').forEach(h => h.classList.remove('sorted'));
    th.classList.add('sorted');
    computeAndRender();
  });
});

// -- Layout: header/filters height can vary (the filters row wraps on
// narrow viewports), so the map/table area's height is measured, not a
// hard-coded constant.
function updateLayoutHeight() {
  const header = document.querySelector('header').getBoundingClientRect().height;
  const filters = document.getElementById('filters').getBoundingClientRect().height;
  document.getElementById('layout').style.height = `calc(100vh - ${header + filters}px)`;
}

// -- Resizable map/table split ------------------------------------------------
function loadSplit() {
  try {
    const v = parseFloat(localStorage.getItem(STORAGE_KEY_SPLIT));
    return (v >= 0.15 && v <= 0.85) ? v : 0.55;
  } catch (e) { return 0.55; }
}
function saveSplit(v) {
  try { localStorage.setItem(STORAGE_KEY_SPLIT, String(v)); } catch (e) { /* ignore */ }
}

let splitFrac = loadSplit();

// Widths only -- cheap, no Leaflet involvement, safe to call on every
// mousemove during a drag.
function applyWidths(frac) {
  const layout = document.getElementById('layout');
  const totalW = Math.max(0, layout.clientWidth - 6); // minus resizer width
  document.getElementById('map').style.width = (totalW * frac) + 'px';
  document.getElementById('table-wrap').style.width = (totalW * (1 - frac)) + 'px';
}
// Widths + tell Leaflet its container actually changed size. Calling
// invalidateSize() on every mousemove during a drag (rather than once at
// the end) made the map's internal pixel origin drift wildly off-screen in
// testing -- only call this at rest (initial load, window resize, drag end).
function applySplit(frac) {
  applyWidths(frac);
  if (map) map.invalidateSize();
}

(function setupResizer() {
  const resizer = document.getElementById('resizer');
  let dragging = false;

  function dragTo(clientX) {
    const rect = document.getElementById('layout').getBoundingClientRect();
    let frac = (clientX - rect.left) / rect.width;
    frac = Math.max(0.15, Math.min(0.85, frac));
    splitFrac = frac;
    applyWidths(frac);
  }
  function start(clientX) { dragging = true; resizer.classList.add('dragging'); }
  function end() {
    if (!dragging) return;
    dragging = false;
    resizer.classList.remove('dragging');
    saveSplit(splitFrac);
    if (map) map.invalidateSize();
  }

  resizer.addEventListener('mousedown', (e) => { start(e.clientX); e.preventDefault(); });
  window.addEventListener('mousemove', (e) => { if (dragging) dragTo(e.clientX); });
  window.addEventListener('mouseup', end);

  resizer.addEventListener('touchstart', (e) => { start(e.touches[0].clientX); }, { passive: true });
  window.addEventListener('touchmove', (e) => { if (dragging) dragTo(e.touches[0].clientX); }, { passive: true });
  window.addEventListener('touchend', end);

  window.addEventListener('resize', () => { updateLayoutHeight(); applySplit(splitFrac); });
})();

updateLayoutHeight();
applySplit(splitFrac);
computeAndRender();
</script>
</body>
</html>
